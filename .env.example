# Копировать в .env (не коммитится) — или не копировать вовсе:
# сервер стартует без .env на дефолтах (STORAGE=memory).

# ── сервер ──────────────────────────────────────────────────────────────
PORT=2567
HOST=0.0.0.0

# ── мир ─────────────────────────────────────────────────────────────────
# Пусто = content/default/world.json из репозитория.
WORLD_PATH=
WORLD_ID=default

# ── хранилище ───────────────────────────────────────────────────────────
# memory  — всё в процессе, БД не нужна (режим разработки)
# postgres — ledger в Postgres; требует docker compose up -d и DATABASE_URL
STORAGE=memory
DATABASE_URL=postgres://oasis:oasis@localhost:5432/oasis
REDIS_URL=redis://localhost:6379

# ── комната ─────────────────────────────────────────────────────────────
MAX_PLAYERS_PER_SECTOR=64
LOG_LEVEL=info

# ── авторизация (F0-6/F0-7) ─────────────────────────────────────────────
# Секрет подписи HttpOnly-cookie `oasis.sid`. scripts/deploy.sh генерирует
# его сам при первом запуске. Пусто/короче 16 символов = dev-ключ из
# исходника (session.ts), его знает каждый, кто читал репозиторий, —
# для публичного деплоя такого быть не должно.
# OASIS_AUTH_SECRET=
# Строгий режим: без валидной cookie вход закрыт. deploy.sh ставит
# production сам; для локального прогона в этом режиме — переменная ниже.
# NODE_ENV=production

# ── клиент (Vite, читается в packages/client) ───────────────────────────
# VITE_SERVER_URL=ws://localhost:2567
