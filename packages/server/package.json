{
  "name": "@oasis/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сервер ядра OASIS Core: секторы, AOI, снапшоты/дельты, ledger",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
